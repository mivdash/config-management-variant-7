start: statement*
statement: value -> standalone

?value: INTEGER -> integer
      | STRING  -> string
      | array

array: LIST "(" [value ("," value)*] ")"
LIST: "list"
INTEGER: /[+-]?(?:[1-9][0-9]*|0)(?![0-9a-z])/
STRING: /@"(?:[^"\\\x00-\x1f]|\\(?:["\\\/bfnrt]|u[0-9a-fA-F]{4}))*"/

%import common.WS
%ignore WS
%ignore /\*[^\r\n]*/

start: statement*
?statement: declaration | value -> standalone
declaration: name ":=" value

?value: INTEGER -> integer
      | STRING  -> string
      | array
      | expression

array: LIST "(" [value ("," value)*] ")"
expression: ".{" operation "}."
?operation: "+" operand operand -> add
          | "-" operand operand -> subtract
          | SQRT operand -> square_root
          | SQRT "(" operand ")" -> square_root
?operand: value | name -> reference

name: NAME | LIST | SQRT
LIST: "list"
SQRT: "sqrt"
INTEGER: /[+-]?(?:[1-9][0-9]*|0)(?![0-9a-z])/
STRING: /@"(?:[^"\\\x00-\x1f]|\\(?:["\\\/bfnrt]|u[0-9a-fA-F]{4}))*"/
NAME: /[a-z]+/

%import common.WS
%ignore WS
%ignore /\*[^\r\n]*/

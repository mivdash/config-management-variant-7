start: statement*
?statement: declaration | value -> standalone
declaration: name ":=" value

?value: INTEGER -> integer
      | STRING  -> string
      | array

array: LIST "(" [value ("," value)*] ")"
name: NAME | LIST
LIST: "list"
INTEGER: /[+-]?(?:[1-9][0-9]*|0)(?![0-9a-z])/
STRING: /@"(?:[^"\\\x00-\x1f]|\\(?:["\\\/bfnrt]|u[0-9a-fA-F]{4}))*"/
NAME: /[a-z]+/

%import common.WS
%ignore WS
%ignore /\*[^\r\n]*/
